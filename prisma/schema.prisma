generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String    @default("Admin")
  totpSecretEncrypted String?
  totpEnabled         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime  @default(now())
}

model Page {
  id              String         @id @default(cuid())
  slug            String         @unique
  customDomain    String?        @unique
  clientName      String
  /** URL da logo da marca (upload na lista Clientes). */
  logoUrl         String?
  segment         String
  /** Identificadores livres (ex.: VIP, prioridade, código do cliente). */
  tags            String[]       @default([])
  status          PageStatus     @default(DRAFT)
  draftData       Json
  publishedData   Json?
  /** Canvas Ze (siteJson v2) — rascunho do ambiente livre. */
  canvasDraft     Json?
  /** Snapshot do canvas publicado (quando publishEngine = CANVAS). */
  canvasPublished Json?
  /** Último ambiente aberto no studio. */
  editorMode      EditorEngine   @default(PUCK)
  /** Motor que o site público renderiza após publicar. */
  publishEngine   EditorEngine   @default(PUCK)
  publishedAt     DateTime?
  seoTitle        String         @default("")
  seoDescription  String         @default("")
  archetype       String?
  currentVersion  Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  versions        PageVersion[]
  leads           Lead[]
  analytics       AnalyticsDaily[]
  intakeInvites   IntakeInvite[]
}

model PageVersion {
  id        String        @id @default(cuid())
  pageId    String
  page      Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  data      Json
  label     String?
  source    VersionSource
  createdAt DateTime      @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model Lead {
  id         String    @id @default(cuid())
  pageId     String
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  payload    Json
  ipHash     String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([pageId, createdAt])
  @@index([ipHash, createdAt])
}

model AnalyticsDaily {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)
  ctaClicks Int      @default(0)

  @@unique([pageId, day])
}

model AiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  provider  String
  result    Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/** Uploads em produção (Railway): disco efêmero quebra; Postgres persiste. */
model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  mimeType  String
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RateBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EditorEngine {
  PUCK
  CANVAS
}

enum VersionSource {
  MANUAL
  AUTOSAVE
  AI
  PUBLISH
  RESTORE
}

enum IntakeStatus {
  PENDING
  SUBMITTED
  USED
  EXPIRED
}

model IntakeInvite {
  id             String            @id @default(cuid())
  token          String            @unique
  status         IntakeStatus      @default(PENDING)
  expiresAt      DateTime
  clientNameHint String?
  segmentHint    String?
  notes          String?
  pageId         String?
  page           Page?             @relation(fields: [pageId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  submission     IntakeSubmission?

  @@index([status, createdAt])
  @@index([expiresAt])
}

model IntakeSubmission {
  id          String       @id @default(cuid())
  inviteId    String       @unique
  invite      IntakeInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  payload     Json
  submittedAt DateTime     @default(now())
}
