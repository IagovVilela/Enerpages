{
  "name": "enerpages",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:deploy": "prisma db push && tsx prisma/seed.ts",
    "db:reset-admin": "node scripts/reset-admin-password.mjs",
    "db:setup": "prisma db push && prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma && tsx prisma/seed.ts",
    "brand:extract": "node scripts/extract-brand-assets.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/client": "^6.19.3",
    "@puckeditor/core": "^0.23.0",
    "hash-wasm": "^4.12.0",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "otpauth": "^9.5.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
